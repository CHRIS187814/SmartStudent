{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "flutter pub get && flutter build web"
  },
  "deploy": {
    "startCommand": "python -m http.server 8000 --directory build/web",
    "healthcheckPath": "/",
    "runDirectory": "frontend/SmartStudent"
  }
}
